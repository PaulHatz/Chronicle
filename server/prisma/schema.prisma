// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(MANAGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
  TEAM_LEADER
}

model EvaluationTemplate {
  id         Int    @id @default(autoincrement())
  department String
  version    String
  name       String
  
  evaluations Evaluation[]
  questions   EvaluationQuestion[]
}

model EvaluationQuestion {
  id                   Int    @id @default(autoincrement())
  evaluationTemplateId Int
  questionText         String
  questionType         String
  rubric               Json?
  minScore             Int?
  maxScore             Int?

  template EvaluationTemplate @relation(fields: [evaluationTemplateId], references: [id])

  answers EvaluationAnswer[]
}

model EvaluationAnswer {
  id                   Int @id @default(autoincrement())
  evaluationQuestionId Int
  evaluationId         Int

  scoreAnswer Int?
  textAnswer  String?

  evaluation Evaluation         @relation(fields: [evaluationId], references: [id])
  question   EvaluationQuestion @relation(fields: [evaluationQuestionId], references: [id])

  @@unique([evaluationId, evaluationQuestionId])
}

model Employee {
  id          Int            @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String?        @unique
  phone       String?
  position    String
  department  String
  status      EmployeeStatus @default(ACTIVE)
  hireDate    DateTime
  evaluations Evaluation[]
  notes       ManagerNote[]
  writeUps    WriteUp[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Evaluation {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  evaluationTemplateId Int
  template             EvaluationTemplate @relation(fields: [evaluationTemplateId], references: [id])

  answers EvaluationAnswer[]

  completedAt DateTime @default(now())
}

model ManagerNote {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  title      String
  content    String
  createdAt  DateTime @default(now())
}

model WriteUp {
  id         Int         @id @default(autoincrement())
  employeeId Int
  employee   Employee    @relation(fields: [employeeId], references: [id])
  type       WriteUpType
  reason     String
  resolvedAt DateTime?
  createdAt  DateTime    @default(now())
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  LEAVE
}

enum WriteUpType {
  VERBAL_WARNING
  WRITTEN_WARNING
  FINAL_WARNING
}
